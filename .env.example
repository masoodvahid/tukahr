APP_NAME=TukaHR
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Tehran
APP_LOCALE=fa

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tukahr
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=tukahr-login
KAVENEGAR_APPROVAL_TEMPLATE=tukahr-approval
KAVENEGAR_LOW_CREDIT_THRESHOLD=100000
KAVENEGAR_TIMEOUT_SECONDS=8
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60

# Local/test system administrator created by php artisan db:seed.
# Keep this disabled in production.
TUKA_TEST_ADMIN_ENABLED=true

# Optional configured HR manager (used by php artisan db:seed)
TUKA_ADMIN_NAME=
TUKA_ADMIN_MOBILE=
TUKA_ADMIN_PASSWORD=
